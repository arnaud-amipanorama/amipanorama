# AMI Panorama — Next.js site
# Copy this file to .env.local and fill in your values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://amipanorama.com

# ── Prise de rendez-vous (page /rendez-vous) ──
# Lien Google Calendar de réservation (lien de partage public). Utilisé par le bouton CTA.
NEXT_PUBLIC_BOOKING_URL=https://calendar.app.google/sLYXj9s7nDiMwzYu8
# OPTIONNEL — pour afficher le calendrier directement dans la page (iframe) au lieu d'un bouton :
# coller l'URL d'intégration fournie par Google (Partager → Intégrer, contient "gv=true").
# Laisser vide pour garder le bouton "Voir les disponibilités".
NEXT_PUBLIC_BOOKING_EMBED_URL=

# ── Notifications de leads (formulaire de contact + chat) ──
# 1) Email via Resend (https://resend.com)
#    - Créer un compte, vérifier le domaine amipanorama.com, générer une clé API.
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=info@amipanorama.com
# Adresse d'envoi sur un domaine VÉRIFIÉ dans Resend :
LEAD_NOTIFICATION_FROM=AMI Panorama <leads@amipanorama.com>
# Expéditeur de l'accusé de réception envoyé AU PROSPECT.
# Optionnel : si vide, on réutilise LEAD_NOTIFICATION_FROM.
LEAD_CONFIRMATION_FROM=AMI Panorama <contact@amipanorama.com>

# Vérifier ce qui est réellement branché sur un environnement donné :
#   curl https://amipanorama.com/api/lead
# → renvoie uniquement des booléens, jamais une clé.

# 2) Miroir Notion (base "Leads")
#    - Créer une intégration interne : https://www.notion.so/my-integrations
#    - Partager la base Leads avec cette intégration, puis copier l'ID de la base.
NOTION_TOKEN=
NOTION_LEADS_DB=

# 3) Webhook générique optionnel (Zapier / Make / Airtable…) — laisser vide si non utilisé
WEBHOOK_URL=

# ── Chat en direct (Crisp) ──
# Créer un compte gratuit sur https://crisp.chat → Settings → Website Settings → Website ID.
# Tant que cette variable est vide, le widget de chat actuel (email/Notion) reste actif.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ── Simulateur de financement (/internal/simulator) ──
# Mot de passe d'accès à l'outil interne (obligatoire pour déverrouiller la page).
SIMULATOR_PASSWORD=
# Optionnel : webhook dédié pour enregistrer les simulations (Make/n8n/HubSpot…).
SIMULATION_WEBHOOK_URL=

# ── Legacy Wix (non utilisé par le flux actuel ; à conserver si besoin) ──
# WIX_CLIENT_ID=
# WIX_API_KEY=
